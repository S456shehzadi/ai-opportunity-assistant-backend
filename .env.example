# ==============================================================================
# AI Opportunity Assistant - Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------------------------
# Options: development, staging, production, testing
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
MAINTENANCE_MODE=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opportunity_assistant
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_STATEMENT_TIMEOUT=15000

# ------------------------------------------------------------------------------
# 3. Cache & Distributed Lock (Redis)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=20
REDIS_SOCKET_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# MUST be 32+ cryptographically random characters in production!
JWT_SECRET_KEY=dev-insecure-jwt-secret-do-not-use-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_STANDARD_PER_MINUTE=120
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=10

# Max request payload in bytes (default: 10MB)
MAX_PAYLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. Object Storage (S3 / MinIO / Local)
# ------------------------------------------------------------------------------
# Options: local, s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
STORAGE_BUCKET_NAME=opportunity-assistant-storage
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. Observability & Circuit Breakers
# ------------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=8000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# 7. External AI & Search Providers
# ------------------------------------------------------------------------------
TAVILY_API_KEY=
SERPAPI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
