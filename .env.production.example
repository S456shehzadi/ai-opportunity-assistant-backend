# ==============================================================================
# AI Opportunity Assistant - Production Environment Template
# (.env.production.example)
# ==============================================================================
# Instructions:
# 1. Copy this template to .env.production on your secure production deployment host:
#    cp .env.production.example .env.production
# 2. Fill in production secrets, credentials, and connection strings from your
#    secret manager (AWS Secrets Manager, GCP Secret Manager, or HashiCorp Vault).
#
# CRITICAL SECURITY RULES:
# - NEVER commit real production .env files or credentials to git repository!
# - Ensure file permissions are strictly restricted (e.g., chmod 600 .env.production)
# ==============================================================================

# Application Environment
APP_ENV=production
APP_NAME="AI Opportunity Assistant"
APP_VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & Cryptography
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_32_CHAR_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://opportunity-assistant.com","https://app.opportunity-assistant.com"]

# Production Managed Database (PostgreSQL with SSL enabled)
# Note: config.py validates that production DATABASE_URL cannot contain "localhost"
DATABASE_URL=postgresql+asyncpg://app_prod_user:SECURE_DB_PASSWORD@prod-db.internal.cluster:5432/opportunity_prod?ssl=require
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30.0
DATABASE_POOL_RECYCLE=1800
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Distributed Caching & Locks (Redis Sentinel / Cluster)
REDIS_URL=rediss://:SECURE_REDIS_PASSWORD@prod-redis.internal.cluster:6379/0
REDIS_POOL_SIZE=25
REDIS_CACHE_TTL=3600

# Observability & Crash Reporting
LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=https://your-sentry-key@o0.ingest.sentry.io/0

# Production Rate Limits (Per Client IP / Authenticated User)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_SEARCH_PER_MIN=30
RATE_LIMIT_ASSISTANT_PER_MIN=20
RATE_LIMIT_ADMIN_PER_MIN=60

# Production Guardrails & Budget Controls
STAGING_NOTIFICATION_SANDBOX=false
BETA_COHORT_MODE=false
AI_BUDGET_DAILY_LIMIT_USD=100.0
SEARCH_BUDGET_DAILY_LIMIT_USD=50.0

# S3-Compatible Object Storage
OBJECT_STORAGE_BACKEND=S3
OBJECT_STORAGE_BUCKET=opportunity-assistant-production-assets
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=PROD_S3_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=PROD_S3_SECRET_KEY

# Production AI Model & Search Providers
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=tvly-prod-YOUR_SEARCH_API_KEY
SEARCH_FALLBACK_PROVIDER=serpapi
SERPAPI_API_KEY=

# Production Email & Push Notification Providers
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.YOUR_SENDGRID_PRODUCTION_API_KEY
SMTP_FROM_EMAIL=support@opportunity-assistant.com
