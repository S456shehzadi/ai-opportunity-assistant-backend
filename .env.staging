# ==============================================================================
# AI Opportunity Assistant - Staging Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=staging
APP_NAME="AI Opportunity Assistant (Staging)"
APP_VERSION="0.1.0-beta.1"
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & Authentication (Staging Secrets)
SECRET_KEY="staging-secret-key-do-not-use-in-production-random-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["https://staging.opportunityassistant.app","http://localhost:3000","http://127.0.0.1:3000"]

# Database (Staging Isolated Database)
DATABASE_URL="postgresql+asyncpg://staging_user:staging_pass@localhost:5432/ai_opportunity_staging_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30.0

# Redis Cache (Staging Isolated Cache DB 1)
REDIS_URL="redis://localhost:6379/1"
REDIS_CACHE_TTL=3600

# Observability
LOG_LEVEL="DEBUG"
PROMETHEUS_METRICS_ENABLED=true

# Staging Safeguards & Sandboxes
STAGING_NOTIFICATION_SANDBOX=true
BETA_COHORT_MODE=true
RATE_LIMIT_ENABLED=true

# Daily Cost & Resource Budget Limits (Prevent runaway cloud costs during Beta)
AI_BUDGET_DAILY_LIMIT_USD=50.0
SEARCH_BUDGET_DAILY_LIMIT_USD=25.0

# Provider Settings
AI_MODEL_PROVIDER="mock"
AI_MODEL_NAME="mistral-7b-instruct"
SEARCH_PROVIDER="mock"
